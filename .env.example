# 数据库配置
DATABASE_URL=sqlite:///./data/hub.db

# 论坛地址（Flarum 实例；同时是 oauth-center 的 OAuth provider base）
FORUM_URL=https://forum.ballance.top

# JWT 过期时间（秒，默认 604800=7 天）
TOKEN_EXPIRE=604800

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET=ballance-golden-ball-secret-change-me

# Flarum oauth-center 客户端凭据（在 Flarum 后台 OAuth Center 建好 client 后填入）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# 管理员 Flarum 用户名白名单（JSON 数组或逗号分隔）
ADMIN_USERNAMES=["ghomist"]

# Flarum 数据库连接（只读，用于判定 Flarum 管理员组 group_id=1；留空则仅用白名单）
FLARUM_DB_URL=

# 前端对外地址（OAuth 登录回调后把浏览器导向这里，dev 为 vite 地址）
FRONTEND_URL=http://localhost:5173

# CORS 配置（JSON 数组或逗号分隔）
CORS_ORIGINS=["*"]
